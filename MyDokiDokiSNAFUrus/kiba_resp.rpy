label k_code_in:
    $ k_day = "True"
    if k_scene1 == "False":
        call k_scene1 from _call_k_scene1
        return
    if k_scene1 == "True" and k_scene2 == "False":
        call k_scene2 from _call_k_scene2
        return
    else:
        call k_lunch_random from _call_k_lunch_random_1
        return
    return

label k_code_out:
    if k_scene2 == "True" and k_scene3 == "False":
        call k_scene3 from _call_k_scene3
        return
    return

label k_code_weekend:
    if k_scene3 == "True" and k_scene4 == "False":
        call k_scene4 from _call_k_scene4
        return
    if k_scene4 == "True" and k_scene5 == "False":
        call k_scene5 from _call_k_scene5
        return
    return



label kiba1_good:
    show kiba 1h at t11
    k "Вау! Я не думал, что ты из тех, кто справляется с подобными вещами."
    show kiba 1a
    "Я немного обижен тем, каким унизительным был его тон только что."
    "...{i}но я думаю, что он в некотором роде прав."
    mc "Не совсем. Просто я сегодня уже кое с кем говорил об этом."
    k 1p "В самом деле? Кто?"
    return

label kiba1_bad:
    show kiba 1p at t11
    k "В этом что-то есть?"
    k 1h "Чувак, держу пари, у парня, который это придумал, были довольно надоедливые друзья, да?"
    "Меня беспокоит тот факт, что я не могу сказать, ведет ли он себя так, будто ничего не заметил, или действительно упустил суть."
    k "Но нет. На самом деле сегодня последний день, когда люди присоединяются к культурному клубу."
    show kiba 1a
    "...{i}действительно, как мой комментарий вообще не взволновал его?"
    mc "Ох, так вот что ты имел в виду..."
    mc "Да, вообще-то я уже кое с кем говорил об этом."
    k 1p "В самом деле? Кто?"
    return

label kschool1:
    mc "Сейчас самое подходящее время сообщить ему, как всё прошло вчера."
    "Постояв несколько минут на обычном месте, я замечаю, как он направляется ко мне."
    show kiba 1h at t11
    k "Боже мой. Это неожиданно!"
    "Как только он открывает рот, это начинает казаться плохой идеей."
    show kiba 1a
    mc "Должен ли я вообще спрашивать, какая часть этого 'неожиданна'?"
    k 1h "Ну, если ты настаиваешь на том, чтобы знать, я полагаю, я {i}мог бы{/i} рассказать тебе--"
    show kiba 1a
    mc "Вообще-то, неважно. Я потерял интерес."
    mc "Пошли. Мы опоздаем, если будем продолжать стоять здесь."
    "Я пытаюсь повернуться, чтобы уйти, но имею дело с настойчивым."
    k 1h "Ах, опять холодный прием..."
    k "А я-то думал, что твоя вновь вспыхнувшая страсть растопила бы твоё ледяное сердце."
    show kiba 1a
    mc "{i}Вздыхаю..."
    mc "Я знаю, что, вероятно, пожалею об этом, но скажи мне прямо, Киба..."
    mc "О чем, черт возьми, ты говоришь?"
    k 3h "Ха, 'о чем ты говоришь', - спрашивает он. Как будто он не знает."
    "По мере того, как я продолжаю его слушать, мой мозг начинает отвлекаться на что-то более примитивное."
    k 1h "Простите мой подход. Возможно, вам было бы удобнее, если бы я вместо этого поздравил вас?"
    show kiba 1a
    mc "..."
    "Мой гневный взгляд мало что делает для того, чтобы смягчить его глупость."
    k 1h "Извините, извините. Позвольте мне выразиться точнее."
    k "Я говорю, конечно, о чуде, когда два далеких друга детства воссоединяются благодаря общим интересам и снова безумно влюбляются друг в друга!"
    k "Даже с целым гаремом красивых девушек, отчаянно добивающихся его внимания, эти двое никогда не теряют из виду ту, которая утешала их так давно."
    k "Несмотря на все трудности и душевную боль, им всё же удается снова собраться вместе, питая новую и гораздо более сильную страсть!"
    k "Подумать только, что такая прекрасная вещь действительно могла произойти в этом холодном, жестоком мире, в котором мы живем..."
    k 1a "Этого почти достаточно, чтобы вызвать слезы у меня на глазах."
    show kiba 1a
    "После последней реплики он делает паузу, как будто ожидает каких-то оваций."
    "Вместо этого он просто встречает мой всё более мрачный взгляд смерти."
    mc "Я впечатлен, Киба."
    mc "Тебе удалось сказать что-то настолько безумное и бессвязное, что я даже не знаю, с чего начать отрицать это..."
    mc "Но я всё равно буду стараться изо всех сил."
    mc "{i}Хмм{/i}, давай посмотрим..."
    mc "Прежде всего, я должен начать с того, что скажу 'нет'. Просто 'нет'."
    mc "Твой бред настолько неуместен, что меня действительно беспокоит, что тебе удалось его придумать."
    mc "Возможно, в наших интересах было бы поместить вас в психиатрическое отделение."
    k 1h "Боже. Ты такой цундере, [player]."
    show kiba 1a
    "Я понимаю, что он говорит всё это только для того, чтобы вызвать у меня реакцию..."
    "Именно поэтому тот факт, что меня заставили подарить ему один, так сильно меня бесит."
    "...{i}как будто этот парень профессиональный подстрекатель или что-то в этом роде."
    k 1h "Знаешь, меня немного задевает сглаз."
    k "Как ты можешь быть так раздражен, услышав, безусловно, мою самую большую историю любви на сегодняшний день!?"

    show kiba 1a
    "Я зажимаю кончик носа в попытке унять головную боль, которую в настоящее время носит имя 'Киба'."
    "После долгого вздоха я возвращаю своё внимание к нему."
    mc "Я просто рад, что ты выбросил это из головы..."
    mc "Хотя я удивлен тем, какое шоу ты смог устроить, даже не спросив меня о том, что на самом деле произошло с клубом."
    k 1h "А? Зачем мне спрашивать?"
    k "Я имею в виду, ты же {i}действительно{/i} присоединился, не так ли?"
    show kiba 1a
    mc "Ох? И почему ты так в этом уверен?"
    k 1f "Я не знаю. Наверное, просто казалось очевидным, что ты так и сделаешь."
    show kiba 1a
    mc "'{i}Очевидный{/i}'?"
    k 1h "Да. Я имею в виду, почему бы и нет?"
    k "Ты действительно хорошо читаешь, и есть факт, что именно Сайори на самом деле пригласила тебя..."
    k "К тому же, такая официально звучащая группа наверняка будет хорошо смотреться в резюме студентов колледжа."
    k "Я знал, что в конечном итоге ты так или иначе присоединишься к клубу, даже если бы ты {i}был{/i} ждал до последней минуты."
    show kiba 1a
    mc "На самом деле это не--"
    k 1h "Да ладно тебе, не отрицай этого."
    k "Несмотря на все разговоры о том, чтобы стать 'мужем-домоседом', ты так же стараешься поступить в колледж, как и все остальные."
    show kiba 1a
    mc "..."
    k 1h "Возможно, я сказал это в шутку, но ты {i}на самом деле{/i} цундере."
    show kiba 1a
    "...{i}Не знаю, что с ним происходило в последнее время, но случайные моменты проникновения Кибы в мои мысли и жизнь полностью выбивают меня из колеи."
    k 1h "О, но не думай, что мои слова снимут тебя с крючка."
    show kiba 1a
    mc "'Снят с крючка'? Что вы имеете в виду?"
    k 1h "Я по-прежнему жду полного отчета о вашем клубе и всех его членах как можно скорее. Никаких но!"
    show kiba 1a
    mc "Да, да. Я займусь этим прямо сейчас."
    mc "Я даже заламинирую это в качестве награды за то, что ты такой молодец."
    k 1h "Вот это настрой!"
    show kiba at thide
    hide kiba
    "Поскольку моя позиция в клубе была изложена, мы вдвоем продолжаем наш путь в школу."
    $ ch1_scene = "True"
    return

label kschool2:
    "Придя на обычное место, я стою и жду, когда появится Киба."
    "Однако то, что ко мне обращается, - это оболочка, которая выглядит так, как будто её оживили с помощью вуду."
    show kiba 1k at t11
    k "А, [player], я вижу, ты всё-таки пришел."
    k "Мне следовало ожидать этого. У меня и так было занято время..."
    k "Но подумать только, что это произойдет так скоро после того, как я узнаю правду. Думаю, мой номер действительно закончился."
    "Вместо того, чтобы вмешиваться, как я обычно делаю, я просто позволяю Кибе продолжать нести чушь."
    k "Как бы то ни было, я приготовился к этому. Я готов!"
    k "Я оставила записку своей семье на случай, если это произойдет, так что тебе не нужно беспокоиться о них."
    "После того, как Киба, казалось, собрался с духом, он выпрямляется и смотрит на меня с серьезным выражением лица."
    k 1e "Тогда давай, заканчивай! Делай то, зачем ты сюда пришел!"
    "...{i}почему все наши разговоры должны начинаться с того, что они такие непонятные?"
    show kiba 1d2
    "Я наблюдаю, как Киба плотно закрывает глаза, что выглядит как попытка подготовиться к удару."
    "Зная, что лучше не потакать его проделкам, я разворачиваюсь и начинаю идти к школе."
    mc "Да ладно, я ждал здесь не только для того, чтобы ты заставил меня опоздать."
    k 1p "А? По-настоящему?"
    k "Ты хочешь сказать, что не собираешься меня устранять?"
    mc "'Устранить тебя', huh? А вот это интересная идея..."
    mc "Но я не могу сказать, что планировал сделать это в ближайшее время."
    k "Вау, вот это сюрприз!"
    k "Ты же знаешь, я действительно оставила записку."
    mc "Наверное, было бы лучше, если бы я не спрашивал, но почему именно вы были уверены, что я планирую 'устранить' вас?"
    k 1f "А, ох..."
    k "Ну, я просто предположил, что, поскольку у тебя теперь есть гарем, ты попытаешься избавиться от любого, кто потенциально может встать у тебя на пути."
    "...{i}да, не стоило спрашивать."
    "...{i}этот парень действительно настолько помешан или он просто потрясающий актер."
    show kiba 1b
    mc "Да, это определенно солидный ход твоих мыслей..."
    mc "Но, к сожалению, я не вижу в тебе 'угрозы' тому, что, по твоему мнению, у меня есть."
    k 5a "Я понимаю..."
    k "Ты хочешь сказать, что моё существование настолько незначительно для тебя, что ты даже не замечаешь моего присутствия."
    k 5b "Значит, так оно и есть."
    "Кибе требуется время, чтобы собраться с мыслями, в то время как я в основном пытаюсь игнорировать его."
    k 2a "Хотя в этом есть какая-то ирония судьбы."
    k "Подумать только, что {i}ты{/i} окажешься в подобном положении после того, как заявишь, что подобные ситуации вымышлены."
    k "Похоже, все мои молитвы и исследования были напрасны."
    show kiba 1b
    mc "Прежде всего, Киба, нет богов настолько благосклонных, чтобы они даровали тебе гарем только потому, что ты попросил об этом..."
    mc "А во-вторых, в какой бы 'ситуации', по-твоему, я ни оказался, ты должен знать, что ты далек от истины."
    mc "Да, я единственный парень в клубе, полном девушек. Это точно."
    mc "Что {i}неточно{/i}, так это твоё представление о том, что я их всех очень привлекаю и они постоянно пытаются вступить в половую связь."
    mc "Если бы был способ доказать, что моё целомудрие в неприкосновенности, я бы сделала это прямо сейчас."
    mc "Так что перестань впадать в депрессию и прекрати писать странные записки, которые до смерти напугали бы твоих родителей, хорошо."
    "Я говорю всё это всё более измученным тоном."
    k 5a "{i}Хмм{/i}..."
    k 1f "Ты серьезно? Здесь действительно нет ничего смешного?"
    mc "Киба, ты знаешь меня достаточно долго, чтобы понимать, что во мне нет абсолютно ничего смешного."
    k 5a "Понятно. Ты определенно прав насчет этого..."
    "...{i}маленький панк. Как насчет того, чтобы сказать это снова!"
    k 1e "Очень хорошо. Пока я верю твоим словам, но не думай, что я уже отказался от этого испытания!"
    "...{i}не сдался? Разве ты не просил меня \"устранить\" тебя несколько минут назад?"
    k "Правильно! Я преодолею этот барьер и докажу своё превосходство!"
    mc "Не помню, чтобы я спрашивал обо всем этом..."
    k "Только смотри, у меня в мгновение ока будет свой собственный гарем, и я покажу тебе, что тяжелая работа {i}действительно{/i} окупается!"
    show kiba 1d
    "Сказав всё это с огромной гордостью, Киба выжидающе смотрит на меня."
    mc "{i}Вздыхаю..."
    mc "Конечно. Хорошо смотрится... о чем бы, черт возьми, ты ни говорил."
    k 1h "Хах, удача даже не понадобится!"
    k "Тебе лучше начать прикрывать спину, [player], потому что я иду за этой короной!"
    show kiba 1a
    "...{i}он путается в своих иллюзиях или здравомыслящие люди просто не в состоянии понять такого рода вещи?"
    show kiba at thide
    hide kiba
    "Похоже, воодушевленный его бредом, Киба ускоряет шаг, в то время как я продолжаю волочить ноги."
    $ ch2_scene = "kiba"
return



label kiba_sunday1:
    mc "Хорошо, Киба. У меня не было никаких других планов, так что я не против присоединиться к тебе."
    k 1bh "Срань господня! Ты серьезно?!"
    mc "Я не могу не чувствовать некоторого раздражения, когда ты ведешь себя {i}так{/i} удивлен."
    k 2bb "М-Моя вина, просто я на самом деле не ожидал, что ты согласишься."
    mc "А ты бы предпочел, чтобы я этого не делал?"
    k 1bh "Вовсе нет! Так намного лучше!"
    k "Я зайду к тебе домой минут через двадцать. Это нормально?"
    show kiba 1ba
    mc "Это прекрасно."
    k 1bh "Милая. Тогда увидимся."
    show kiba 1ba
    mc "Верно."
    scene bg living_day
    hide kiba
    with wipeleft
    "Когда Киба заканчивает разговор, в голову приходит несколько мыслей."
    "...{i}не то чтобы мы никогда не проводили время вместе вне школы, но в большинстве случаев он просто приходил и практически заставлял себя..."
    "...{i}возможно, это первый раз, когда он законно пригласил меня что-то сделать..."
    "...{i}и я не могу винить его за то, что он был удивлен. До недавнего времени я, без сомнения, отклонил бы это предложение."
    "..."
    "...{i}интересно, это ли то, что имела в виду Сайори, когда просила меня вступить в клуб?"
    "Почесав в затылке, я направляюсь в свою спальню, чтобы переодеться во что-нибудь более подходящее."
    scene bg door_m with dissolve_scene_full
    "Через пятнадцать минут после телефонного звонка в мою парадную дверь стучат."
    mc "Ты рано."
    show kiba 1bh at t11
    k "Да, извини за это. Подготовка заняла меньше времени, чем я думал."
    show kiba 1ba
    mc "Всё в порядке. Не пытался жаловаться."
    show kiba at thide
    hide kiba
    scene bg resday with wipeleft
    "Я запираю за нами дверь после того, как выхожу на улицу."
    mc "У тебя было представление о том, куда мы собираемся бежать на самом деле?"
    show kiba 2bb at t11
    k "Э-хе-хе, насчет этого..."
    k "Поскольку ты уже делал что-то подобное раньше, я подумал, что мы просто последуем твоему примеру."
    mc "Хм, понятно. Это определенно упростило бы задачу, по крайней мере, для меня."
    show kiba 1bb
    "Киба смотрит на меня в замешательстве."
    mc "Что-то не так?"
    k 1bf "О-ох, не совсем..."
    k 2ba "Ты просто проявил удивительное понимание."
    k "Я вроде как ожидал, что ты скажешь что-то вроде 'ты пригласил меня только для того, чтобы я сделал всю работу, не так ли?'"
    k "Я был немного застигнут врасплох."
    show kiba 1bb
    mc "Понимаю."
    "Без ведома Кибы, моя голова всё ещё затуманена моими предыдущими мыслями о намерениях Сайори. Хотя я и знаю, что они скатываются к паранойе."
    mc "Хотя я и не в восторге от того, насколько ты шокирована после того, как я проявил малейший намек на доброту..."
    mc "Я понимаю, к чему ты клонишь. У меня в голове были кое-какие мысли, которые, кажется, заставили меня по-другому мыслить."
    mc "Впрочем, всё должно проясниться, как только мы действительно двинемся в путь."
    k "...{i}'что у тебя на уме?'"
    mc "Ты уже потянулся?"
    k 1bf "А-а? О, да. Я так и думал, прежде чем прийти сюда."
    show kiba 1bb
    mc "Отлично, это значит, что нам не нужно терять времени."
    mc "Ты готов?"
    k 1bh "Есть, сэр!"
    show kiba at thide
    hide kiba
    "С этими словами мы с Кибой побежали трусцой по улице, медленно набирая скорость, пока не набрали хороший темп."
    scene dark with dissolve_scene_full
    "Учитывая недостаточную подготовку Кибы, я решаю, что чередовать скорости было бы проще для него."
    "Мы проводили некоторое время на бегу, затем трусцой, затем бегом обратно и так далее. Иногда, когда Киба выглядел так, будто ему тяжело, мы вдвоем тоже некоторое время гуляли."
    scene bg street_day with open_eyes
    "Хорошая возможность отдохнуть появляется, когда мы заканчиваем наш маршрут во второй раз."
    mc "Как насчет того, чтобы остановиться на минутку~"
    show kiba 1bf at t11
    k "Ох, слава Богу!"
    show kiba 1bd2 at sink
