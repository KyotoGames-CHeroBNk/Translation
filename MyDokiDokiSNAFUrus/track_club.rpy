

label r_code_in:
    $ r_day = "True"
    if r_scene1 == "False":
        call r_scene1 from _call_r_scene1
        return
    if r_scene1 == "True" and r_scene2 == "False":
        call r_scene2 from _call_r_scene2
        return
    if r_scene2 == "True" and r_scene3 == "False":
        call r_scene3 from _call_r_scene3
        return
    if r_scene4 == "True" and r_scene5 == "False":
        call r_scene5 from _call_r_scene5
        return
    if r_scene5 == "True" and r_scene6 == "False" and r_love == "False":
        call r_scene6 from _call_r_scene6
        return
    if r_love == "True" and r_love1 == "False":
        call r_love1 from _call_r_love1_1
        return
    if r_love3 == "True" and r_love4 == "False":
        call r_love4 from _call_r_love4_1
        return
    else:
        call r_club_random from _call_r_club_random_3
        return

label r_code_out:
    if r_love1 == "True" and r_love2 == "False":
        call r_love2 from _call_r_love2
        return

label r_code_weekend:
    if r_scene3 == "True" and r_scene4 == "False":
        call r_scene4 from _call_r_scene4_1
        return
    if r_scene6 == "True" and r_scene7 == "False":
        call r_scene7 from _call_r_scene7_1
        return
    if r_love2 == "True" and r_love3 == "False":
        call r_love3 from _call_r_love3_1
        return



label track_day1:
    scene bg office with dissolve_scene_full
    play music t8
    $ r_appeal = r_appeal + 5
    "После последнего звонка я направился в кабинет преподавателя, чтобы поговорить с консультантом."
    "Она рассказала мне кое-что о команде. Очевидно, информация Кибы была не слишком точной, поскольку она объясняет мне, что тренер довольно популярен в близлежащих университетах."
    "Мистер Такахаси, так его зовут, кажется, довольно замечательный парень. Она даже упоминает, что он готов дать рекомендации студентам, у которых, по его мнению, есть потенциал."
    "Мой консультант заметила, что я оживился, когда она упомянула об этом, и продолжила улыбаться."
    $ r_name = "Советник"
    r "Ну, ты присоединился к команде довольно поздно, учитывая, что ты на третьем курсе и всё такое..."
    r "Но мистер Такахаси судит о характере так же хорошо, как и о спортсменах. Если вы произведете хорошее впечатление, я уверен, что, возможно, он сможет протянуть вам руку помощи."
    r "Помимо этого, единственное, что остается вам сказать, это то, что команда собирается по вторникам, средам и четвергам, если, конечно, не будет дождя."
    r "Однако во время ознакомительного периода они будут встречаться каждый день недели, так что ты можешь заходить в любое время."
    r "Иногда они проводят соревнования по легкой атлетике с другими местными школами, но от вас не требуется участвовать в них..."
    r "И на этом всё. Я уверен, что мистер Такахаси расскажет подробнее и будет рад ответить на любые вопросы, которые могут возникнуть по ходу дела."
    r "Он и остальная команда должны быть на трассе прямо сейчас, так что, если вы настроены присоединиться, можете смело переодеваться в спортивную форму и выходить на трассу."
    "Как только она закончит рассказывать мне всё, я кланяюсь и благодарю её за помощь."
    "Затем я направляюсь в раздевалку, чтобы переодеться."
    scene bg track with dissolve_scene_full
    $ r_name = "Мистер Такахаси"
    "Когда я выхожу на поле, меня встречает дородный мужчина с лучезарной улыбкой на лице."
    r "Ахх, ещё один новичок! Похоже, в этом году наша команда снова будет многочисленной!"
    r "Приятно познакомиться, малыш, меня зовут Казами Такахаси, но ты можешь называть меня просто тренер Така!"
    $ r_name = "Тренер Така"
    mc "Приятно познакомиться. Меня зовут [player] класса 3-B."
    r "Ахх, похоже, у тебя неплохие манеры, парень. Это будет глоток свежего воздуха среди других преступников."
    "Некоторые другие спортсмены, стоящие вокруг нас, смеются, когда он это говорит."
    r "Ты сказал класс 3-Б, верно? Похоже, у меня не будет много времени, чтобы привести тебя в форму, но я сделаю всё, что в моих силах!"
    "Он улыбается мне ещё шире и хлопает по плечу."
    r "Итак, малыш~ Я имею в виду [player], ты когда-нибудь раньше выступал в команде?"
    mc "Нет, сэр, только в качестве хобби."
    r "Хобби, да? По крайней мере, это значит, что тебе это нравится!"
    r "Тогда ладно, новичок! Поскольку это твой первый день, я попрошу тебя провести несколько мероприятий с командой, чтобы ты смог прочувствовать их!"
    r "Как только вы найдете то, что вам нравится или с которым вы чувствуете себя комфортно, мы попросим вас сосредоточиться на нем! Звучит хорошо ?!"
    mc "Да, сэр, тренер Така."
    r "Вот это настрой!"
    r "Ладно, вы, другие бездельники, научите его канатам! Покажите ему растяжки, научите основам, а затем двигайтесь!"
    r "Ознакомительная неделя означает, что я заставлю тебя работать особенно усердно!"
    "Более старшие участники отважно отвечают \"Да, сэр!\", прежде чем подвести меня к линии старта и кратко изложить суть дела."
    scene bg track with wipeleft_scene
    "Остальные попросили меня присоединиться к ним в их упражнении по растяжке, прежде чем дать мне объяснение о различных мероприятиях."
    "Они подробно рассказали о том, как должен проводиться каждый из них и как работают 'заезды' на соревнованиях по легкой атлетике."
    "Мне показалось, что я многому научился о соревновательном беге так же, как и они."
    $ i_appeal = i_appeal + 2
    "--Интеллект увеличен на 2--"
    if i_appeal >= 15:
        call int_level from _call_int_level_3
    "Как только я освоил основы, я провел несколько мероприятий в попытке найти то, которое мне понравилось."
    "По мере того, как я бежал, угнаться становилось всё труднее и труднее, но я как-то справлялся."
    "К тому времени, как я закончил, мне показалось, что у меня горят ноги."
    $ a_appeal = a_appeal + 3
    "--Атлетизм увеличился на 3--"
    if a_appeal >= 15:
        call ath_level from _call_ath_level
    "Я решил, что мне больше нравится бегать на средние дистанции, и выбрал 400 метров в качестве своего вида спорта."
    r "Итак, все, сегодня мы здорово постарались!"
    r "Помните, что я не допускаю никаких негативных эмоций на своем треке, поэтому каждый делает всё возможное, чтобы поладить! Оставь все свои драмы в раздевалке, здесь ты представитель своей школы и своих товарищей по команде."
    r "Что ещё более важно, ты мой представитель, так что не делай ничего такого, что поставит ужин с женой в неловкое положение, ладно?"
    "У некоторых других участников раздается несколько смешков."
    r "И это всё! Я с нетерпением жду встречи со всеми вами в следующий раз!"
    "Команда ещё раз отвечает \"Да, сэр!\", прежде чем начать расходиться."
    "Всё ещё чувствуя некоторый шок в ногах, я решаю присесть на краю поля, чтобы отдохнуть."
    stop music fadeout 2.0
    "Когда окружающий меня шум начинает стихать, я погружаюсь в раздумья."
    "...{i}\"Оставь всю свою драму в раздевалке, здесь ты представитель\"..."
    "...{i}вся наша драма, да? Я признаю, что главная причина, по которой я бегаю,- это проветрить голову, но всё же..."
    mc "Если бы только это было так просто."
    $ r_name = "???"
    r "У тебя вошло в привычку разговаривать с самим собой?"
    mc "Что?"
    show rikka 1a at t11
    play music wefn
    "Я оборачиваюсь и вижу девушку, стоящую позади меня."
    "...{i}она всё ещё в форме, значит ли это, что она не в команде?"
    "Я встаю, чтобы посмотреть ей в лицо, когда она начинает представляться."
    r 3b "Приятно познакомиться, незнакомец! Меня зовут Рикка Фудзикава, ученица 2-Б класса!"
    show rikka 3a
    $ r_name = "Рикка"
    "Я продолжаю смотреть на девушку по имени \"Рикка\" с растерянным выражением лица."
    r 3b "Ох, точно! Это не признание или что-то в этом роде. Я разговариваю с тобой, потому что я менеджер команды по легкой атлетике!"
    r 3f "Полагаю, мне следовало начать с этого, да?"
    "Она неловко смеется, а я по-прежнему пребываю в замешательстве."
    r 1b "Ооочень, теперь, когда я представился..."
    show rikka 1a
    "Говоря это, она делает мне знак руками."
    mc "Правильно, меня зовут [player] класса 3-B. Приятно познакомиться."
    r 1c "Класс 3-Б? Оуу, чувак, тренер Тэкки не говорил, что ты выпускник..."
    r 1e "И вот я надеялся, что наконец-то смогу запугать какого-нибудь новичка-первокурсника теперь, когда я перешел на второй курс."
    show rikka 1c
    "Девушка открывает глаза и несколько раз просматривает мою внешность."
    r 5h "Эхх, думаю, мне следовало догадаться. Ты слишком высокий для первокурсника."
    mc "Жаль вас разочаровывать."
    r 5j "Хех, тебе, черт возьми, лучше бы так и было~"
    show rikka 1i at h11
    r "Эрмм, я имею в виду~"
    "Она по какой-то причине начинает паниковать, когда у меня начинает немного болеть голова."
    "У меня сжимается сердце, когда я понимаю, что она чем-то напоминает мне Кибу."
    r "И-извини за это. Не хотел использовать такие выражения в присутствии члена команды."
    mc "Язык? Ты должен был говорить при нас по-французски или что-то в этом роде?"
    r 5l "Ну, ха ха. Ты настоящий комик, не так ли [player]..."
    r 5m "Но нет. Тренер Тэкки сказал, что менеджеру не следует использовать 'ненормативную лексику' перед своей командой. Сказал что-то о том, что это подает плохой пример."
    show rikka 5n
    mc "Понимаю."
    mc "Я не пытался быть саркастичным в своем предыдущем заявлении. Я действительно не знал, что ты выругался."
    show rikka 1c
    mc "Если ты обычно так говоришь, то всё в порядке. Я выросла среди довольно вульгарных людей, так что, вероятно, всё равно ничего не замечу."
    r "Кто-нибудь вульгарный, да?"
    r 3h "Хех, только не говори мне, что ты один из тех перспективных спортсменов с какой-то трагической предысторией."
    mc "Хмм..."
    mc "Дайте определение слову 'трагический.'"
    r 3i "Эрмм, верно? Я не могу сказать, издеваешься ты надо мной или нет, так что я просто положу этому конец."
    r 1b "В любом случае, я бы сказал, что мы уже знакомы, так что моя работа здесь выполнена!"
    show rikka 1a
    "Девушка ухмыляется, как будто она сделала что-то действительно стоящее."
    mc "Ты сказал, что был менеджером команды, верно? Я не помню, чтобы видел тебя на тренировке."
    "Я ещё раз оглядываю её, пытаясь подтвердить то, что она мне рассказала."
    "...{i}Думаю, она выглядит довольно спортивно."
    r 3m "Эй, перестань смотреть на меня, как на какого-то бездельника, ладно?"
    r 3b "Я просто немного опоздал, вот и всё. Когда я вышел, тренер Тэкки сказал, что новичок остался остыть..."
    r "Отсюда мое появление перед тобой!"
    show rikka 3a
    "Она разводит руки в стороны и отвешивает экстравагантный поклон."
    mc "Правильно..."
    "Я немного вытягиваю ноги и обнаруживаю, что боль в них в значительной степени утихла."
    mc "Если это всё, тогда я возвращаюсь."
    r 1b "Хорошо. Тренер Тэкки также сказал мне показать раздевалку, в которой ребята обычно переодеваются перед тренировкой."
    r "Он намного ближе к трассе, чем обычный, но он немного маленький."
    show rikka 1a
    "Рикка идет рядом со мной, когда я направляюсь к зданию школы."
    "Пока мы идем, я решаю затронуть кое-что, что меня беспокоит."
    mc "Тебе не кажется немного странным давать своему тренеру такое прозвище?"
    r 1c "Что?"
    r 1b "Ох, ты говоришь о тренере Тэкки."
    r 3k "Я мог бы рассказать тебе, но это довольно длинная история со множеством пикантных моментов. Всё ещё хочешь её услышать?"
    mc "Нет. Не могу сказать, что мне так уж интересно это знать."
    r 5g "Оуу, ты серьезно? Не может быть, чтобы ты действительно был таким занудой, не так ли?"
    r "Обычно, когда девушка рассказывает 'пикантные подробности,' парни слетаются к ней, как кошачья мята."
    show rikka 1c at h11
    r "Ох! Это потому, что ты качаешься в 'ту сторону?'"
    mc "Извините, что разочаровываю вас ещё раз, но, боюсь, я полностью гетеросексуален."
    mc "Просто мне не хочется слушать длинную личную историю от человека, с которым я только что познакомился..."
    mc "Или вообще кто угодно, если уж на то пошло."
    r 1e "Боже, что за нелюдимость..."
    r 1c "И я просто пошутил насчет 'длинной истории' и 'пикантных моментов.'"
    r 1b "Я называю его 'Тренер,' но он мне больше как дядя. Он и мой отец были друзьями ещё до моего рождения."
    r "В детстве я всегда называл его Безвкусным, а когда он стал моим тренером, это как-то смешалось."
    show rikka 1a
    mc "Понимаю."
    r 3l "Хорошо, и я надеюсь, что для вас это была не слишком {i}длинная{/i} история."
    r 3j "В конце концов, не хотелось бы тратить ваше драгоценное время впустую."
    mc "Не беспокойся. Твое объяснение было довольно кратким, и не похоже, что я был занят чем-то важным."
    mc "Я бы сказал, что мое время ни в коем случае не было потрачено впустую."
    r 1g "Ха, серьезно?"
    r "Такие люди, как ты, действительно существуют?"
    "Рикка продолжает растерянно смотреть на меня, когда мы входим в здание школы."
    scene bg hall3 with wipeleft_scene
    "После того, как Рикка показала мне \"раздевалку\", которой пользуются другие участники трека, она останавливает меня."
    show rikka 1b at t11
    r "И это всё!"
    r "Как я уже сказал, она довольно маленькая, но это избавит вас от необходимости идти пешком до той, что рядом со спортзалом."
    r "Полагаю, там сейчас находятся твои вещи?"
    show rikka 1a
    mc "Спасибо, и да. Там моя одежда."
    r 2b "Тогда ладно. Думаю, увидимся на практике--"
    s "[player]?"
    mc "Хмм?"
    show rikka 2a at t22
    show sayori 3b at t21
    "Я оборачиваюсь и вижу Сайори у подножия лестницы."
    show rikka 1a
    mc "Привет, Сайори. Почему ты всё ещё здесь? Разве клуб не закрылся некоторое время назад?"
    s "Ха, ох... Так и было, но я остался, чтобы помочь Монике с кое-какими вещами, поэтому только сейчас ушел."
    r 2b "Вау, она симпатичная Семпай. Она твоя сестра или что-то в этом роде?"
    "...{i}хмм? \"Сэмпай?\""
    show rikka 2a
    mc "И что именно заставляет тебя так думать?"
    r 2b "Не знаю, ты просто не похож на парня, с которым девушкам нравится общаться. Вокруг тебя какая-то 'антисоциальная аура.'"
    show rikka 2a
    mc "Не могу оспаривать факты, но нет. Она не моя сестра."
    s "Ум, [player]...?"
    "Сайори наклоняется и пытается говорить шепотом."
    s "Кто она?"
    mc "Понятия не имею. Она преследует меня последние 20 минут, и я, кажется, не могу отделаться от неё."
    mc "Наверное, просто один из тех одержимых любовью сталкеров."
    mc "'Яндере,' не так ли?"
    show rikka 1o at h22
    r "Эй! Не говори ей этого! Она подумает, что я какой-то чудак!"
    "Рикка прочищает горло, издавая, по-видимому, сердитое ворчание."
    r 1b "Приятно познакомиться. Меня зовут Рикка Фудзикава, я из класса 2-B. Ты друг Сэмпай?"
    s 3b "Сэмпай? Ох, ты имеешь в виду [player]?"
    s 3x "Да, мы вместе в одном клубе. Меня зовут Сайори."
    show sayori 3a
    r 1c "Вместе в одном клубе?"
    s 1x "Да, мы оба члены литературного клуба!"
    show sayori 1a
    r "Неужели?"
    "Рикка снова смотрит на меня и начинает изучать мою внешность."
    r 5j "Да, в этом есть смысл. Ты больше похож на книжного червя, чем на спортсмена."
    s 2n "'Спортсмен?'"
    r 1b "Ох да..."
    r 3b "Я менеджер легкоатлетической команды, так что именно так мы и знаем друг друга. С тех пор как это был его первый рабочий день, я вводил его в курс дела."
    show rikka 3a
    s "..."
    s "....."
    s 4m "Эххх?"
    s "Подожди, ты присоединился к команде по легкой атлетике [player]?!"
    mc "Разве компания не выдала это?"
    s "П-правда? Почему ты мне не сказал?!"
    mc "Хмм..."
    mc "Ты не спрашивал?"
    s 3h "Ну, конечно, я этого не делал! Я и понятия не имел, что тебе так нравится бегать!"
    s 3g "П-подожди, это значит, что ты собираешься уйти из клуба?"
    "Сайори кажется искренне подавленной, когда эта мысль приходит ей в голову."
    mc "Не могу сказать, что я это планировал. Решил, что сделаю и то, и другое."
    show sayori 3d at s21
    "Она вздыхает с облегчением, когда я говорю это."
