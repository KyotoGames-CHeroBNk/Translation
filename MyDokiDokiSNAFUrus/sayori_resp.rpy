

label s_code_in:
    $ s_day = "True"
    if s_scene1 == "False":
        call s_scene1 from _call_s_scene1
        return
    if s_scene1 == "True" and s_scene2 == "False":
        call s_scene2 from _call_s_club1
        return
    if s_scene2 == "True" and s_scene3 == "False":
        call s_scene3 from _call_s_scene3
        return
    if s_scene3 == "True" and s_scene4 == "False":
        call s_scene4 from _call_s_scene4
        return
    if s_scene4 == "True" and s_scene5 == "False" and s_love == "False":
        call s_scene5 from _call_s_scene5
        return
    if s_scene5 == "True" and s_scene6 == "False":
        call s_scene6 from _call_s_scene6_2
        return
    else:
        call s_club_random from _call_s_club_random_4
        return

label s_code_out:
    if s_love1 == "True" and s_love2 == "False":
        call s_love2 from _call_s_love2
        return
    if s_love2 == "True":
        call s_love3 from _call_s_love3
        return

label s_code_weekend:
    if s_scene6 == "True" and s_scene7 == "False":
        call s_scene7 from _call_s_scene6
        return
    if s_love == "True" and s_love1 == "False":
        call s_love1 from _call_s_love1
        return
    if s_love2 == "True" and s_love3 == "False":
        call s_love3 from _call_s_love3_2
        return

label s_scene1:
    $ s_scene1 = "True"
    $ s_appeal = s_appeal - 10
    "Что-то заметно изменилось во внешности Сайори, когда она подходит к моему столу."
    show sayori 1x at t11
    s "Привет, [player]."
    show sayori 1a
    mc "..."
    mc "....."
    s 1b "Ум, алло?"
    mc "........"
    "Она начинает неловко ерзать."
    s 2b2 "Что-то не так? Ты как бы пялишься на меня."
    mc "Ты случайно не поздно проснулся сегодня утром?"
    s 2c "А? Что заставляет тебя так говорить?"
    show sayori 2b
    mc "Ну, на самом деле, многое..."
    mc "Твой блейзер помят, жилет не разглажен, волосы торчат во все стороны~"
    show sayori 4m at h11
    s "Эххх! Ты действительно всё это заметил?!"
    mc "Я имею в виду, да. Это кажется довольно очевидным."
    "...{i}вообще-то, я обычно обращаю внимание на подобные вещи?"
    "Не особо задумываясь, я начинаю пытаться поправить её волосы своими руками."
    s 4b2 "Ух, тебе действительно не обязательно это делать..."
    s "Это довольно сложно исправить, не почистив предварительно щеткой."
    mc "Значит ли это, что у вас случайно нет под рукой щетки?"
    s 2l "Эхехе..."
    s "Возможно, это выглядело бы иначе, если бы я это сделал."
    show sayori 1k2
    mc "Хотя это правда, что твои растрепанные волосы могут выглядеть привлекательно..."
    mc "Есть существенная разница между тем, чтобы быть 'милым и эксцентричным' и 'вечно ленивым.'"
    mc "Я просто не хочу, чтобы кто-нибудь ещё знал, что ты уже переступил эту черту."
    show sayori 1m at h11
    s "Какая 'очередь?!' Я не {i}настолько{/i} ленив!"
    mc "Я понял, я понял. Просто перестань уже ерзать."
    s 1l "Ох, извините."
    show sayori 1k2
    "Сайори остается неподвижной, пока я продолжаю пытаться придать ей более презентабельный вид."
    mc "Это практически всё, что можно сделать в парикмахерском отделе."
    mc "Теперь, что касается твоего жилета..."
    s 1x "Правильно! Без проблем!"
    show sayori 1a
    "Она начинает пытаться выпрямить волосы, но при этом делает только хуже."
    "Вместо того, чтобы потянуть влево, как следовало, она потянула вправо, отчего поворот стал ещё более однобоким."
    mc "...{i} неужели человек действительно может быть настолько некомпетентен?"
    s 1b "Что?"
    mc "Ничего. Вот, просто снова стой спокойно."
    "Я наклоняюсь и хватаю жилет возле живота Сайори..."
    show sayori 4q
    "Что заставляет её немедленно начать трястись."
    s 4r "Эхехехе..."
    s "Остановись, [player]! Щекотно!"
    mc "Не могли бы вы не делать так, чтобы всё казалось странным. В этом не было бы необходимости, если бы вы могли всё исправить сами."
    "Её неконтролируемое хихиканье продолжается до тех пор, пока мне наконец не удается привести жилет в приличный вид."
    s 4q "Хмхмхмхмх..."
    "После того, как она вытерла слезы из уголков глаз, к ней возвращается самообладание."
    show sayori 1a
    mc "Теперь остался только блейзер..."
    "...{i}на каждой руке по нескольку морщин, но в данный момент я не в состоянии справиться с ними."
    mc "Подожди, разве тебе не положено держать эти вещи застегнутыми?"
    s 3n "А, так это ты?"
    mc "Я так и думал. Почти уверен, что оставлять платье расстегнутым без причины."
    s 3a "Оооо, приятно это знать."
    mc "..."
    s "..."
    mc "Ну?"
    s 3x "Что Ну?"
    show sayori 3a
    mc "Ты не собираешься застегнуть его?"
    s 3c "А? А должен ли я?"
    show sayori 3b
    mc "Простите, если я как-то неправильно это понял, но что мы только что обсуждали?"
    s "...?"
    s 3c "Это вопрос с подвохом?"
    show sayori 3b
    mc "Вздох..."
    "Сайори смотрит на меня с растерянным выражением лица, пока я потираю виски."
    mc "Забудь об этом. Просто подойди сюда на минутку."
    s 3b2 "А? Подожди, кто ты~"
    scene s_cg1
    with dissolve_cg
    mc "Морщины, возможно, и не разгладятся, но после этого они, по крайней мере, будут выглядеть несколько лучше."
    "Сайори начинает смеяться про себя вскоре после того, как начинаю я."
    s "Эхехе..."
    s "Это довольно забавно, тебе не кажется?"
    mc "Неужели? Моё чувство юмора в лучшем случае на низком уровне, так что тебе придется объяснить."
    s "Ты знаешь..."
    s "Ты делаешь такие вещи для меня. Это заставляет меня чувствовать себя немного странно, как в детстве."
    mc "Не припомню, чтобы я когда-нибудь помогал тебе одеваться, когда мы были моложе, и был бы очень признателен, если бы ты никому не рассказывала, что я это делал."
    mc "Моя моральная репутация в этом клубе уже, кажется, под вопросом."
    s "Не волнуйся, я уверен, что на самом деле никто в эту чушь не верит..."
    s "Вероятно."
    mc "Вау, Сайори, спасибо за вотум доверия. Это заставляет меня чувствовать себя намного лучше."
    mc "Когда ты научился так хорошо использовать слова?"
    "Она отвечает на мой сарказм неловким смешком."
    mc "Чувак, эту штуку становится трудно застегивать..."
    mc "Ты уверен, что оно тебе подходит?"
    s "Эхехе~"
    s "Так и было, когда я его покупал."
    mc "Ну, если бы ты потратила время на то, чтобы носить его должным образом, ты, вероятно, заметила бы, что оно больше не подходит."
    mc "Руки и длина кажутся нормальными, но ширина около туловища слишком мала."
    s "..."
    mc "И чему это {i}ты{/i} улыбаешься, сопляк? Ввязываешься в драку?"
    s "Нет."
    s "Это просто означает, что мои сиськи снова стали больше!"
    mc "Хмм?"
    "... развитие более женственных черт Сайори"
    mc "Поздравляю. Сколько у тебя сейчас, средний класс?"
    s "Эххххххххх!!!"
    mc "А? К чему сейчас такая застенчивость? Это был искренний комплимент твоему росту как женщины."
    s "[player]! Т-ты не можешь говорить такие вещи!"
    s "Боже, это даже близко не похоже на то, как отреагировал бы нормальный парень!"
    mc "Вот как?"
    mc "В таком случае, просвети меня. Как бы 'нормальный парень' повел себя в такой ситуации?"
    s "Т-ты знаешь, он бы такой: 'Н-Не говори ничего подобного' или 'Прекрати, ты меня смущаешь!'"
    "...{i}учитывая близость моей руки к груди Сайори, другие в таком положении действительно могут смутиться, если будет затронуто что-то вроде размера груди."
    mc "Понятно. Спасибо, что прояснил моё недопонимание."
    mc "Позволь мне на этот раз попытаться вести себя 'нормально'. Кхм..."
    mc "'С-Сайори, не произноси этого вслух! Т-ты меня смущаешь!!'"
    mc "Так было лучше?"
    s "Боже, ты действительно безнадежен..."
    mc "Не могу оспаривать факты."
    "Закончив застегивать все пуговицы, до которых ещё можно дотянуться, я делаю шаг назад, чтобы полюбоваться своей работой."
    mc "Видишь, теперь ты выглядишь как настоящий студент этой академии, а не как какой-нибудь нахлебник, стянувший форму со скамейки в парке."
    s "Это не считается комплиментом..."
    "Ей требуется секунда, чтобы пощупать свой недавно застегнутый блейзер."
    s "Как ты думаешь? Это действительно хорошо выглядит вот так?"
    menu:
        "Глядя на это сейчас, я полагаю..."
        "Да, я думаю, что так и есть.":

            s "Правда, но здесь так душно...?"
            "Сайори, кажется, не впечатлена, покачивая туловищем из стороны в сторону."
            s "Уууууу..."
            s "Оно того не стоит!"
            "И в мгновение ока её блейзер снова в обычном состоянии."
        "Я не верю, что внешний вид блейзера является определяющей чертой вашей внешности.":

            $ s_appeal = s_appeal + 3
            s "Наверное, мне не следовало ожидать от тебя прямого ответа..."
            s "Но это значит, что ты считаешь, что я буду хорошо выглядеть в любом случае, верно?"
            mc "Грубо говоря, это {i}является{/i} то, что я сказал."
            s "Хех, ну в таком случае...!"
            "С широкой улыбкой Сайори немедленно расстёгивает все пуговицы."
        "Вообще-то, я предпочитаю, чтобы всё было так, как было.":

            $ s_appeal = s_appeal + 5
            s "П-правда?"
            mc "Ага."
            mc "Подсознательно этот образ более привлекателен. Возможно, из-за присущего человеческому разуму страха перемен."
            s "Ух, я действительно не понимаю..."
            s "Но, по сути, это означает, что тебе больше нравится в расстегнутом виде?"
            mc "С точки зрения непрофессионала, да. Полагаю, что да."
            s "Слава богу!"
            "Вскоре Сайори с выражением облегчения и радости на лице снова стоит в расстегнутом блейзере."

    scene bg club_day
    show sayori 1q at t11
    with dissolve_cg
    s "Фух! Намного лучше!"
    "Она раскидывает руки и кружится."
    "...{i}что ж, мне неприятно видеть, как \"мой тяжелый\" труд пропадает даром..."
    "...{i}но видеть её такой счастливой по-своему приятно."
    s 1b2 "А? [player]?"
    s "Ты... ты покраснела?"
    mc "Хмм?"
    "Конечно же, когда я подношу руку к лицу, на моих щеках отчетливо ощущается жар."
    mc "Странно. Может быть, признаки лихорадки?"
    s "Это-это 'лихорадка?'"
    s 2l "Да, я думаю, это имеет больше смысла. Эхехе..."
    show sayori 2k2
    "Сайори начинает вести себя необычно застенчиво, пока я продолжаю притворяться, что изучаю себя."
    "...{i}странно. Почему, глядя на неё, я так краснею?"
    if s_route_begin == "False":
        $ c_appeal = c_appeal + 5
        "--Общительность повышена на 5--"
    if c_appeal >= 15:
        call soc_level from _call_soc_level_14
    return


label s_scene2:
    show sayori 1a at t11
    $ s_scene2 = "True"
    $ s_appeal = s_appeal - 10
    mc "Привет, Сайори."
    mc "Хочешь провести встречу вместе?"
    s 2x "Да! Звучит забавно--"
    show sayori at t21
    show monika 3b at t22
    m "Ладно, все! Собирайтесь!"
    show monika 3a
    $ s_name = "Сайори и я"
    s "Что?"
    $ s_name = "Сайори"
    show sayori at t31
    show monika at t32
    show yuri 1f at t33
    y "Что-нибудь прояснилось?"
    show yuri 1e
    show sayori at t41
    show monika at t42
    show yuri 1e at t43
    show natsuki 2c at t44
    n "Мы ведь не отменяем ещё одну встречу, не так ли?"
    m 3b "Не волнуйся, ничего страшного."
    m "На самом деле, как раз наоборот!"
    show monika 3a
    mc "Вот как?"
    mc "Так что же это за 'хорошее' дело, ради которого мы 'собрались вокруг'?"
    m 3b "Упражнение по сплочению команды и укреплению доверия..."
    m 4k "В виде столь необходимой весенней уборки!!"
    show monika 4j
    $ s_name = "Сайори и Нат."
    show natsuki 1p at h44
    show sayori 4m at h41
    s "Эхх?! 'Уборка?!'"
    show sayori 4n
    $ s_name = "Сайори"
    y 2b "Как чудесно."
    y "Я просто подумал, что в комнате не помешало бы немного прибраться."
    show sayori 4b
    show yuri 2a
    m 3l "Я рад, что хотя бы один человек в восторге от этой идеи."
    n 5b "А я не могу получить пропуск, потому что мне всегда приходится убирать в домашней уборной?"
    show natsuki 5c
    m 3b "Ну же, Нацуки."
    m 4b "Разве ты не хочешь использовать это как возможность стать ближе к своим коллегам по клубу?"
    show monika 4a
    n 5g "..."
    if n_scene2 == "False":
        mc "Ты не против так на меня смотреть?"
        n "Хмф!"
    if n_scene2 == "True":
        mc "Есть причина, по которой ты на меня пялишься?"
        n 5r "Я-я несобираюсь!"
        show natsuki 5s
    y 2b "Моника права."
    y 2b "Умение ладить друг с другом."
    show yuri 2a
    n 5d "Хех, называть нас 'единомышленниками', когда {i}он{/i} в комнате, практически оскорбление."
    show natsuki 5a
    mc "Кто ты, мой спонсор анонимных алкоголиков?"
    s 4m "Он шутит! Он просто шутит!"
    s "Пожалуйста, не принимайте его всерьез!"
    mc "Тебе действительно нужно было это разъяснять?"
    s 4h "Когда {i}ты{/i} тот, кто это говорит, безусловно!"
    show sayori 4g
    m 2b "Давайте постараемся не слишком отвлекаться на проблему злоупотребления психоактивными веществами [player]."
    m "Как и сказал Юри, в последнее время комната выглядит немного мрачновато."
    m "Так почему бы не воспользоваться ситуацией, чтобы хоть раз поработать вместе?"
    m 4k "В конце концов, продвижение облигаций {i}является{/i} частью моей работы на посту президента."
    show monika 4j
    mc "{i}...ты мог бы одурачить меня."
    show monika 2h
    "Она бросает в мою сторону свирепый взгляд."
    show monika 2a
    n 5k "Разве на дежурстве обычно нет студентов, которые занимаются подобными вещами?"
    n "Почему {i}мы{/i} должны это делать?"
    show natsuki 5k2
    m 2n "Ну, не хочу принижать значение тех, на кого возложена такая ответственность--"
    mc "Люди халтурят на уборке, как будто это выходит из моды."
    m 2l "Э-Эхехе..."
    show monika 2a
    n 5k "Значит, мы выбираем таких людей, как [player]?"
    n "Поговорим о хромоте."
    show natsuki 5k2
    s 3h "Н-Нацуки--"
    show sayori 3g
    mc "Всё в порядке."
    mc "Хотя чистота в моем доме и на рабочем месте важна для меня, обязанности по уборке."
    m 5b "Это действительно то, в чем ты должен признаться перед президентом своего клуба?"
    mc "Я всего лишь пытаюсь сохранить мир между вице-президентом и коротышкой."
    mc "Не стоит меня благодарить."
    n 5f "{i}Этот парень..."
    m 1r "{i}Вздыхаю..."
    s 4n "Вау, по сравнению с ним даже Моника выглядела измученной."
    y 3o "В-возможно, нам следует вернуться к теме."
    m 1a "Спасибо, Юри."
    m 2b "Короче говоря, мы убираем комнату, потому что нам это нужно {i}и{/i} потому что черный труд способствует сближению."
    m "Если у вас есть какие-либо жалобы, пожалуйста, направляйте их вице-президенту!"
    show monika 2a
    s 4m "Х-ха? Почему я?!"
    n 2b "Почему бы нам просто не сказать учительнице, что её ученики халтурят?"
    n "Разве это не было бы лучшим решением в долгосрочной перспективе?"
    show natsuki 2c
    show sayori 4b
    y 2b "Нам было предоставлено право использовать эту комнату для встреч клуба, Нацуки."
    y "Самое меньшее, что мы могли бы сделать,"
    show yuri 2a
    m 4b "Хорошо сказано!"
    show monika 4a
    n 2g "Угг..."
    m 2b "Ворчи сколько хочешь после свершившегося факта. А пока..."
    "Моника раскладывает различные чистящие средства на столе учителя."
    show natsuki at thide
    show yuri at thide
    show sayori at thide
    hide natsuki
    hide yuri
    hide sayori
    show monika at t11
    m "Я также приготовил это, чтобы упростить задачу."
    show monika 2a
    "Она показывает несколько полосок бумаги, на конце каждой нацарапано своё слово."
    mc "Теперь мы бросаем жребий?"
    m 2b "Учитывая, что некоторые из вас относятся к групповому упражнению с меньшим энтузиазмом, чем другие, они были созданы для предотвращения возникновения каких-либо споров."
    "Она засовывает их себе в руку так, что видны только пустые части."
    m 2k "Тогда ладно!"
    m 1b "Кто первый?"
    show monika at thide
    hide monika
    scene bg club_day with wipeleft_scene
    "Мы все стоим и смотрим на наши случайно назначенные задания после того, как каждый нарисовал полосу."
    show monika 1b at t11
